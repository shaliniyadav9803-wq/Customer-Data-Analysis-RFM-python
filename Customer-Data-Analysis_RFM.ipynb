   "id": "d2879f0d-c388-4263-b7e9-1f8986f1173d",
   "metadata": {},
   "source": [
    "## Use a reference date to compute Recency in number of days "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "ab2be874",
   "metadata": {},
   "outputs": [],
   "source": [
    "from datetime import timedelta \n",
    "today = df[\"TransactionDate\"].max() + timedelta(days=1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "611e039e",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/plain": [
       "Timestamp('2025-07-30 00:00:00')"
      ]
     },
     "execution_count": 19,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "today"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "58ac9bf5",
   "metadata": {},
   "outputs": [],
   "source": [
    "cust[\"Recency\"] = (today - LastDate[\"LastTransactionDate\"]).dt.days"
   ]
  },
