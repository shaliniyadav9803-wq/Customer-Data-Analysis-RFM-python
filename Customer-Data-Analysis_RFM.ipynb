  {
   "cell_type": "markdown",
   "id": "cb31612a-0130-4c22-b603-4139ed2bd66f",
   "metadata": {},
   "source": [
    "## Step 5: Score RFM \n",
    "## Use quantile-based scoring using pd.qcut()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "e7b2ae86",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_rfm[\"R_Score\"] = pd.qcut(df_rfm[\"Recency\"], 5, labels = [5,4,3,2,1])\n",
    "df_rfm[\"F_Score\"] = pd.qcut(df_rfm[\"Frequency\"], 5, labels = [1,2,3,4,5])\n",
    "df_rfm[\"M_Score\"] = pd.qcut(df_rfm[\"Monetary\"], 5, labels = [1,2,3,4,5])"
   ]
  },
